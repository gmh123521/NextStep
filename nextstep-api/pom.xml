<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.nextstep</groupId>
        <artifactId>nextstep-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nextstep-api</artifactId>
    <name>nextstep-api</name>
    <description>API 聚合启动入口</description>

    <dependencies>
        <dependency>
            <groupId>com.nextstep</groupId>
            <artifactId>nextstep-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nextstep</groupId>
            <artifactId>nextstep-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nextstep</groupId>
            <artifactId>nextstep-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nextstep</groupId>
            <artifactId>nextstep-data-school</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nextstep</groupId>
            <artifactId>nextstep-data-gov</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nextstep</groupId>
            <artifactId>nextstep-data-job</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nextstep</groupId>
            <artifactId>nextstep-analysis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nextstep</groupId>
            <artifactId>nextstep-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nextstep</groupId>
            <artifactId>nextstep-planner</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
