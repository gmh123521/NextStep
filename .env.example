# ===== NextStep 部署环境变量样例 =====
# 拷贝为 .env 后修改：cp .env.example .env

# MySQL
MYSQL_DB=nextstep
MYSQL_USER=root
MYSQL_PWD=root
MYSQL_PORT=3306

# Redis
REDIS_PWD=
REDIS_PORT=6379

# 对外暴露的前端端口（nginx）
WEB_PORT=8000

# 阿里云百炼 API Key（不配则 AI 功能不可用）
DASHSCOPE_API_KEY=

# JVM 调优
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=70 -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8
